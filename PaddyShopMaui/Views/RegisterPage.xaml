<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PaddyShop.ViewModels"
             xmlns:controls="clr-namespace:PaddyShop.Controls"
             x:Class="PaddyShop.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Đăng ký tài khoản">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="2">
            <Label Text="Thông tin cá nhân" Style="{StaticResource SectionTitle}" />
            <controls:ProfileFormView BindingContext="{Binding Form}" />

            <Label Text="Tài khoản" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
            <Label Text="Tên đăng nhập" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding Username}" Placeholder="vd: paddy_fan" MaxLength="20" />
            </Border>
            <Label Text="{Binding UsernameHint}" TextColor="{Binding UsernameHintColor}" FontSize="12" Margin="4,2,0,0" />

            <Label Text="Mật khẩu (8-20 ký tự)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding Password}" IsPassword="True" MaxLength="20" />
            </Border>
            <Label Text="Nhập lại mật khẩu" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding ConfirmPassword}" IsPassword="True" MaxLength="20" />
            </Border>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}"
                   HorizontalTextAlignment="Center" Margin="0,10,0,0" />
            <Grid Margin="0,12,0,0">
                <Button Text="Đăng ký" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HeightRequest="24" />
            </Grid>
            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,8,0,0">
                <Label Text="Đã có tài khoản?" VerticalOptions="Center" />
                <Button Text="Đăng nhập" Style="{StaticResource TextButton}" Command="{Binding LoginCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
