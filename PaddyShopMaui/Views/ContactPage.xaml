<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PaddyShop.ViewModels"
             x:Class="PaddyShop.Views.ContactPage"
             x:DataType="vm:ContactViewModel"
             Title="Liên hệ">
    <Grid>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
        <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="Center" Padding="24" Spacing="12">
            <Label Text="{Binding ErrorMessage}" HorizontalTextAlignment="Center" />
            <Button Text="Thử lại" Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>
        <ScrollView IsVisible="{Binding HasInfo}">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Image Source="{Binding Info.LogoUrl}" HeightRequest="60" Aspect="AspectFit" />
                        <Label Text="{Binding Info.Name}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Info.Company}" TextColor="White" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="Hotline" Style="{StaticResource Muted}" />
                            <Label Text="{Binding Info.Hotline}" FontAttributes="Bold" FontSize="16" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Gọi" Command="{Binding CallCommand}" HeightRequest="40" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="Email" Style="{StaticResource Muted}" />
                            <Label Text="{Binding Info.Email}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Gửi mail" Command="{Binding SendEmailCommand}" HeightRequest="40" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="Địa chỉ" Style="{StaticResource Muted}" />
                            <Label Text="{Binding Info.Address}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Bản đồ" Command="{Binding OpenMapCommand}" HeightRequest="40" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
