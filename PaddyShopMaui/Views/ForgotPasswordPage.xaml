<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PaddyShop.ViewModels"
             x:Class="PaddyShop.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Quên mật khẩu">
    <ScrollView>
        <VerticalStackLayout Padding="24,24" Spacing="6">
            <Label Text="🔑" FontSize="56" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Instruction}" HorizontalTextAlignment="Center" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,12" />

            <!-- Bước 1: nhập email -->
            <VerticalStackLayout IsVisible="{Binding IsEmailStep}" Spacing="6">
                <Label Text="Email" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding Email}" Placeholder="Email đã đăng ký" Keyboard="Email" ReturnType="Send"
                           ReturnCommand="{Binding SendCodeCommand}" />
                </Border>
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" HorizontalTextAlignment="Center" />
                <Grid Margin="0,10,0,0">
                    <Button Text="Gửi mã xác nhận" Command="{Binding SendCodeCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HeightRequest="24" />
                </Grid>
            </VerticalStackLayout>

            <!-- Bước 2: nhập mã + mật khẩu mới -->
            <VerticalStackLayout IsVisible="{Binding CodeSent}" Spacing="6">
                <Border IsVisible="{Binding InfoMessage, Converter={StaticResource HasValue}}" BackgroundColor="#E6F4EA" StrokeThickness="0"
                        StrokeShape="RoundRectangle 8" Padding="10,8">
                    <Label Text="{Binding InfoMessage}" TextColor="{StaticResource Green}" />
                </Border>
                <Label Text="Mã xác nhận (6 số, hiệu lực 15 phút)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding Code}" Keyboard="Numeric" MaxLength="6" Placeholder="______" />
                </Border>
                <Label Text="Mật khẩu mới (8-20 ký tự)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding NewPassword}" IsPassword="True" MaxLength="20" />
                </Border>
                <Label Text="Nhập lại mật khẩu mới" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding ConfirmPassword}" IsPassword="True" MaxLength="20" />
                </Border>
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" HorizontalTextAlignment="Center" />
                <Grid Margin="0,10,0,0">
                    <Button Text="Đặt lại mật khẩu" Command="{Binding ResetCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HeightRequest="24" />
                </Grid>
                <Grid ColumnDefinitions="*,*">
                    <Button Text="Gửi lại mã" Style="{StaticResource TextButton}" Command="{Binding SendCodeCommand}" />
                    <Button Grid.Column="1" Text="Đổi email" Style="{StaticResource TextButton}" Command="{Binding ChangeEmailCommand}" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
