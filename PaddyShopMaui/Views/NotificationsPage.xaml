<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PaddyShop.ViewModels"
             xmlns:models="clr-namespace:PaddyShop.Models"
             x:Class="PaddyShop.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Thông báo">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Đọc tất cả" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Items}" Margin="12,6">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NotificationItem">
                    <Border Style="{StaticResource Card}" BackgroundColor="{Binding Background}" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{StaticResource Primary}"
                                     VerticalOptions="Start" Margin="0,5,0,0" IsVisible="{Binding IsUnread}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Content}" />
                                <Label Text="{Binding CreatedAtText}" Style="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,60" Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" HorizontalTextAlignment="Center" />
                    <Label Text="🔔" FontSize="48" HorizontalTextAlignment="Center" IsVisible="{Binding IsEmpty}" />
                    <Label Text="Bạn chưa có thông báo nào" IsVisible="{Binding IsEmpty}" HorizontalTextAlignment="Center" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>
</ContentPage>
