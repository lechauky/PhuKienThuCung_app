<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PaddyShop.ViewModels"
             xmlns:controls="clr-namespace:PaddyShop.Controls"
             x:Class="PaddyShop.Views.EditProfilePage"
             x:DataType="vm:EditProfileViewModel"
             Title="Thông tin cá nhân">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="2">
            <Label Text="Tên đăng nhập" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBox}" BackgroundColor="{StaticResource Gray100}">
                <Entry Text="{Binding UsernameText}" IsReadOnly="True" />
            </Border>

            <controls:ProfileFormView BindingContext="{Binding Form}" />

            <Label Text="Địa chỉ này dùng làm địa chỉ nhận hàng khi bạn đặt hàng." Style="{StaticResource Muted}" Margin="4,8,0,0" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}"
                   HorizontalTextAlignment="Center" Margin="0,10,0,0" />
            <Grid Margin="0,12,0,0">
                <Button Text="Lưu thay đổi" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HeightRequest="24" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
