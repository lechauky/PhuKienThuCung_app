<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PaddyShop.ViewModels"
             x:Class="PaddyShop.Views.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="Đổi mật khẩu">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="4">
            <Label Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding OldPassword}" IsPassword="True" />
            </Border>
            <Label Text="Mật khẩu mới (8-20 ký tự)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding NewPassword}" IsPassword="True" MaxLength="20" />
            </Border>
            <Label Text="Nhập lại mật khẩu mới" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding ConfirmPassword}" IsPassword="True" MaxLength="20" />
            </Border>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}"
                   HorizontalTextAlignment="Center" Margin="0,10,0,0" />
            <Grid Margin="0,16,0,0">
                <Button Text="Đổi mật khẩu" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HeightRequest="24" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
